<?xml version="1.0" encoding="UTF-8"?>
<!--
    TWO TEST SUITES:

    unit         Pure PHP, no WordPress or database required. Runs in seconds.
                   vendor/bin/phpunit (flag: testsuite unit)

    integration  Requires a real WordPress test installation + test DB.
                   WP_TESTS_DIR=/tmp/wordpress-tests-lib vendor/bin/phpunit (flag: testsuite integration)

    Code coverage is captured for src/ only; the data-layer base classes
    under src/includes/ are excluded. HTML report:
    vendor/bin/phpunit (flag: coverage-html coverage/)
-->
<phpunit
    bootstrap="tests/bootstrap-unit.php"
    colors="true"
>
    
    <testsuites>

        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>

        <testsuite name="integration">
            <directory>tests/Integration</directory>
            <bootstrap>tests/bootstrap-integration.php</bootstrap>
        </testsuite>

    </testsuites>

    
    

</phpunit>

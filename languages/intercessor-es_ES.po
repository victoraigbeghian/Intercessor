msgid "Requests Per Page"
msgstr "Solicitudes por página"

#: src/Admin/DisplayPage.php:264
msgid "Default number of prayer requests shown in the Prayer Wall block."
msgstr ""
"Número predeterminado de solicitudes de oración mostradas en el bloque Lista "
"de oración."


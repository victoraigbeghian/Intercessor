{
    "name": "intercessor",
    "version": "1.1.1",
    "description": "Intercessor WordPress Plugin — Gutenberg block build tooling",
    "private": true,
    "license": "GPL-2.0-or-later",
    "scripts": {
        "build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
        "start": "cross-env NODE_ENV=development webpack --config webpack.config.js --watch",
        "lint:js": "eslint src/blocks",
        "zip": "node scripts/package-plugin.js",
        "package": "npm run build && node scripts/package-plugin.js",
        "packages-update": "npm update"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@babel/preset-env": "^7.24.0",
        "@babel/preset-react": "^7.24.0",
        "@wordpress/dependency-extraction-webpack-plugin": "^6.0.0",
        "adm-zip": "^0.6.0",
        "babel-loader": "^9.1.3",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "^7.0.3",
        "css-loader": "^6.10.0",
        "serialize-javascript": "^7.0.5",
        "style-loader": "^3.3.4",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "@wordpress/block-editor": "^16.2.0",
        "@wordpress/blocks": "*",
        "@wordpress/components": "*",
        "@wordpress/element": "*",
        "@wordpress/i18n": "*",
        "@wordpress/upload-media": "^0.37.0",
        "fast-uri": "^4.2.1",
        "moment": "^2.31.0",
        "source-map-js": "^1.2.2"
    }
}
